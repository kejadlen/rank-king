# The views are Phlex components, and Phlex ships no RBS, so the
# Steepfile ignores lib/rank_king/views. This is the surface web.rb
# calls on them.
module RankKing
  module Views
    class Home
      def initialize: (lists: Array[List]) -> void
      def call: () -> String
    end

    module Sources
      class Text
        def initialize: (list: List, csrf: Method) -> void
        def call: () -> String
      end
    end

    module ListViews
      class New
        def initialize: (sources: Hash[String, String], csrf: Method) -> void
        def call: () -> String
      end

      class Show
        def initialize: (list: List, csrf: Method, ?axis: Axis?) -> void
        def call: () -> String
      end

      class Compare
        def initialize: (list: List, axis: Axis, csrf: Method) -> void
        def call: () -> String
      end

      class Settings
        def initialize: (list: List, source: String, csrf: Method) -> void
        def call: () -> String
      end
    end
  end
end
