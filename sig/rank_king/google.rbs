# The default client's writer is defined on the singleton class, which
# the inline parser cannot read; tests are what call it.
module RankKing
  class Google
    self.@default: Google?

    def self.default=: (Google?) -> void
  end
end

# Video is a Data class, whose members the inline parser cannot read.
module RankKing
  class Google
    class Video
      attr_reader id: String
      attr_reader title: String
      attr_reader channel_title: String
      attr_reader thumbnail_url: String?

      def self.new: (id: String, title: String, channel_title: String, thumbnail_url: String?) -> instance
    end
  end
end
